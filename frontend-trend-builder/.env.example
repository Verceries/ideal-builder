# This is an example .env file.
# Copy this file to .env and fill in your actual API keys and desired configurations.
# Do NOT commit your actual .env file to version control.

# --- API Keys (Optional) ---
# If these are not provided, the agent will use mock data for inspiration and fonts.

# Unsplash API Key (Client ID)
# Obtain from your Unsplash developer dashboard: https://unsplash.com/developers
# Used in: actions/gather_inspiration.py
UNSPLASH_API_KEY=YOUR_UNSPLASH_ACCESS_KEY_HERE

# Google Fonts API Key
# Obtain from your Google Cloud Platform Console: https://console.cloud.google.com/apis/credentials
# Used in: actions/suggest_assets.py
GOOGLE_FONTS_API_KEY=YOUR_GOOGLE_FONTS_API_KEY_HERE


# --- Logging Configuration (Optional) ---
# Controls the verbosity of application logs.
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Defaults to INFO if not set.
# Used in: config.py to set the root logger level.
# LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG


# --- Other Potential Future Configurations ---
# DEFAULT_TECH_STACK=react-tailwind

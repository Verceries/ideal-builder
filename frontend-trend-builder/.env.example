# This is an example .env file.
# Copy this file to .env and fill in your actual API keys.
# Do NOT commit your actual .env file to version control.

# Unsplash API Key (Client ID)
# Obtain from your Unsplash developer dashboard: https://unsplash.com/developers
# Used in: actions/gather_inspiration.py
UNSPLASH_API_KEY=YOUR_UNSPLASH_ACCESS_KEY_HERE

# Google Fonts API Key
# Obtain from your Google Cloud Platform Console: https://console.cloud.google.com/apis/credentials
# Used in: actions/suggest_assets.py
GOOGLE_FONTS_API_KEY=YOUR_GOOGLE_FONTS_API_KEY_HERE

# Example for other potential future configurations:
# LOG_LEVEL=INFO
# DEFAULT_TECH_STACK=react-tailwind
